# Copy to .env in the repo root on the VM and fill in the values.
INFLUX_HOST=<your influx host>
INFLUX_TOKEN=<your influx token>
INFLUX_DATABASE=iotiview
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=siddharthc6121@gmail.com
SMTP_PASS=<your gmail app password>
ALERT_TO=siddharthc6121@gmail.com,Satish_Shinde@ylconsulting.com,sandesh_khartode@ylconsulting.com
WEBHOOK_URL=
POLL_SECONDS=2
# --- optional: application-down watchdog (dead-man's switch) ---
HEALTHCHECK_URL=            # paste your free healthchecks.io ping URL here (alerts you if the monitor stops)
FEED_STALE_MIN=10           # alert if no new sensor data arrives for this many minutes
